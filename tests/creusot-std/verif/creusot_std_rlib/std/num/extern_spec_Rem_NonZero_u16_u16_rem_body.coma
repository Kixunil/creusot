use creusot.int.UInt16
use creusot.prelude.Any
use int.ComputerDivision
use int.Int

function view_NonZero_u16 [@inline:trivial] (self: UInt16.t) : int = UInt16.t'int self

meta "rewrite_def" function view_NonZero_u16

predicate inv_u16 [@inline:trivial] (_1: UInt16.t) = true

meta "rewrite_def" predicate inv_u16

predicate invariant_NonZero_u16 (self: UInt16.t) = view_NonZero_u16 self <> 0 /\ inv_u16 self

predicate inv_NonZero_u16 [@inline:trivial] (_1: UInt16.t) = invariant_NonZero_u16 _1

meta "rewrite_def" predicate inv_NonZero_u16

let get_u16 (self: UInt16.t) (return (x: UInt16.t)) =
{[@stop_split] [@expl:get 'self' type invariant] inv_NonZero_u16 self}
  any [ return (result: UInt16.t) -> {[@stop_split] [@expl:get ensures] result = self} (! return {result}) ]

constant const_MIN: UInt16.t = (0: UInt16.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_Rem_NonZero_u16_u16_rem_body (self_: UInt16.t) (rhs: UInt16.t) (return (x: UInt16.t)) =
{[@stop_split] [@expl:extern_spec_Rem_NonZero_u16_u16_rem_body requires] ([@stop_split] [@expl:extern_spec_Rem_NonZero_u16_u16_rem_body 'rhs' type invariant] inv_NonZero_u16 rhs)
  /\ ([@stop_split] [@expl:extern_spec_Rem_NonZero_u16_u16_rem_body requires] not (UInt16.t'int self_
    = UInt16.t'int const_MIN
  /\ view_NonZero_u16 rhs = - 1))}
  (! bb0
  [ bb0 = s0
    [ s0 = get_u16 {rhs} (fun (_x: UInt16.t) -> [ &_10 <- _x ] s1)
    | s1 = [ &_12 <- _10 = (0: UInt16.t) ] s2
    | s2 = {[@expl:remainder by zero] not _12} s3
    | s3 = UInt16.rem {self_} {_10} (fun (_x: UInt16.t) -> [ &_ret <- _x ] s4)
    | s4 = return {_ret} ] ]
  [ & _ret: UInt16.t = Any.any_l ()
  | & self_: UInt16.t = self_
  | & rhs: UInt16.t = rhs
  | & _10: UInt16.t = Any.any_l ()
  | & _12: bool = Any.any_l () ])
  [ return (result: UInt16.t) ->
  {[@stop_split] [@expl:extern_spec_Rem_NonZero_u16_u16_rem_body ensures] UInt16.t'int result
    = ComputerDivision.mod (UInt16.t'int self_) (view_NonZero_u16 rhs)}
    (! return {result}) ]
