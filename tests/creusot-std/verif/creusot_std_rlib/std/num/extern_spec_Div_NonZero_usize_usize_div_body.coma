use creusot.int.UInt64
use creusot.prelude.Any
use int.ComputerDivision
use int.Int

function view_NonZero_usize [@inline:trivial] (self: UInt64.t) : int = UInt64.t'int self

meta "rewrite_def" function view_NonZero_usize

predicate inv_usize [@inline:trivial] (_1: UInt64.t) = true

meta "rewrite_def" predicate inv_usize

predicate invariant_NonZero_usize (self: UInt64.t) = view_NonZero_usize self <> 0 /\ inv_usize self

predicate inv_NonZero_usize [@inline:trivial] (_1: UInt64.t) = invariant_NonZero_usize _1

meta "rewrite_def" predicate inv_NonZero_usize

let get_usize (self: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:get 'self' type invariant] inv_NonZero_usize self}
  any [ return (result: UInt64.t) -> {[@stop_split] [@expl:get ensures] result = self} (! return {result}) ]

constant const_MIN: UInt64.t = (0: UInt64.t)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_Div_NonZero_usize_usize_div_body (self_: UInt64.t) (rhs: UInt64.t) (return (x: UInt64.t)) =
{[@stop_split] [@expl:extern_spec_Div_NonZero_usize_usize_div_body requires] ([@stop_split] [@expl:extern_spec_Div_NonZero_usize_usize_div_body 'rhs' type invariant] inv_NonZero_usize rhs)
  /\ ([@stop_split] [@expl:extern_spec_Div_NonZero_usize_usize_div_body requires] not (UInt64.t'int self_
    = UInt64.t'int const_MIN
  /\ view_NonZero_usize rhs = - 1))}
  (! bb0
  [ bb0 = s0
    [ s0 = get_usize {rhs} (fun (_x: UInt64.t) -> [ &_10 <- _x ] s1)
    | s1 = [ &_12 <- _10 = (0: UInt64.t) ] s2
    | s2 = {[@expl:division by zero] not _12} s3
    | s3 = UInt64.div {self_} {_10} (fun (_x: UInt64.t) -> [ &_ret <- _x ] s4)
    | s4 = return {_ret} ] ]
  [ & _ret: UInt64.t = Any.any_l ()
  | & self_: UInt64.t = self_
  | & rhs: UInt64.t = rhs
  | & _10: UInt64.t = Any.any_l ()
  | & _12: bool = Any.any_l () ])
  [ return (result: UInt64.t) ->
  {[@stop_split] [@expl:extern_spec_Div_NonZero_usize_usize_div_body ensures] UInt64.t'int result
    = ComputerDivision.div (UInt64.t'int self_) (view_NonZero_usize rhs)}
    (! return {result}) ]
